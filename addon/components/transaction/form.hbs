<div class="form-wrapper" ...attributes>
    {{! TRANSACTION DETAILS }}
    <ContentPanel @title={{t "ledger.common.transaction-details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">

            {{! Core Fields }}
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "ledger.common.core-information"}}
            </div>

            <InputGroup @name={{t "column.type"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{array "wallet_deposit" "wallet_withdrawal" "wallet_transfer" "gateway_charge" "gateway_refund" "gateway_payout" "adjustment" "earning" "fee"}}
                        @selected={{@resource.type}}
                        @onChange={{fn (mut @resource.type)}}
                        @placeholder={{t "ledger.common.select-type"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">{{ledger-label option "transaction-type"}}</div>
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "column.direction"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{array "credit" "debit"}}
                        @selected={{@resource.direction}}
                        @onChange={{fn (mut @resource.direction)}}
                        @placeholder={{t "ledger.common.select-direction"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">{{ledger-label option "direction"}}</div>
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "column.status"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{array "pending" "succeeded" "failed" "refunded" "voided" "reversed" "expired"}}
                        @selected={{@resource.status}}
                        @onChange={{fn (mut @resource.status)}}
                        @placeholder={{t "ledger.common.select-status"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">{{ledger-label option "status"}}</div>
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "column.currency"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{array
                            "USD"
                            "EUR"
                            "GBP"
                            "AED"
                            "SAR"
                            "QAR"
                            "KWD"
                            "BHD"
                            "OMR"
                            "JOD"
                            "EGP"
                            "NGN"
                            "KES"
                            "GHS"
                            "ZAR"
                            "INR"
                            "PKR"
                            "BDT"
                            "MYR"
                            "SGD"
                            "IDR"
                            "PHP"
                            "THB"
                            "CNY"
                            "JPY"
                            "KRW"
                            "AUD"
                            "CAD"
                            "NZD"
                            "CHF"
                            "SEK"
                            "NOK"
                            "DKK"
                            "BRL"
                            "MXN"
                        }}
                        @selected={{@resource.currency}}
                        @onChange={{fn (mut @resource.currency)}}
                        @placeholder={{t "ledger.common.select-currency"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">{{option}}</div>
                    </PowerSelect>
                </div>
            </InputGroup>

            {{! Amounts }}
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "ledger.common.amounts"}}
            </div>

            <InputGroup @name={{t "column.amount"}}>
                <Input @value={{@resource.amount}} @type="number" class="w-full form-input" placeholder="0.00" disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "ledger.common.fee-amount"}}>
                <Input @value={{@resource.fee_amount}} @type="number" class="w-full form-input" placeholder="0.00" disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "ledger.common.tax-amount"}}>
                <Input @value={{@resource.tax_amount}} @type="number" class="w-full form-input" placeholder="0.00" disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "column.net-amount"}}>
                <Input @value={{@resource.net_amount}} @type="number" class="w-full form-input" placeholder="0.00" disabled={{cannot-write @resource}} />
            </InputGroup>

            {{! Gateway & Payment }}
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "ledger.common.gateway-and-payment"}}
            </div>

            <InputGroup @name={{t "resource.gateway"}}>
                <Input @value={{@resource.gateway}} @type="text" class="w-full form-input" placeholder={{t "ledger.common.e-g-stripe"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "ledger.common.gateway-transaction-id"}}>
                <Input
                    @value={{@resource.gateway_transaction_id}}
                    @type="text"
                    class="w-full form-input"
                    placeholder={{t "ledger.common.gateway-transaction-reference"}}
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "column.payment-method"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{array "card" "bank_transfer" "wallet" "cash"}}
                        @selected={{@resource.payment_method}}
                        @onChange={{fn (mut @resource.payment_method)}}
                        @placeholder={{t "ledger.common.select-payment-method"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">{{ledger-label option "payment-method"}}</div>
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "column.reference"}}>
                <Input @value={{@resource.reference}} @type="text" class="w-full form-input" placeholder={{t "ledger.common.external-reference"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            {{! Description & Notes }}
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "ledger.common.description-and-notes"}}
            </div>

            <InputGroup @name={{t "column.description"}} @wrapperClass="col-span-2">
                <Input
                    @value={{@resource.description}}
                    @type="text"
                    class="w-full form-input"
                    placeholder={{t "ledger.transaction.short-description-of-this-transaction"}}
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "ledger.common.notes"}} @wrapperClass="col-span-2">
                <Textarea @value={{@resource.notes}} class="w-full form-input" rows="3" placeholder={{t "ledger.transaction.internal-notes"}} disabled={{cannot-write @resource}} />
            </InputGroup>

        </div>
    </ContentPanel>

    <Spacer @height="100px" />
</div>