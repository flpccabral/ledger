<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        {{#if this.hasRefunds}}
            <InputGroup @name={{t "ledger.common.customer-email"}} @helpText={{t "ledger.refund.used-when-sending-a-refund-uri"}}>
                <Input @value={{this.email}} @type="email" class="form-input w-full" placeholder={{t "ledger.common.customer-example-com"}} {{on "input" this.setEmail}} />
            </InputGroup>

            <div class="space-y-3">
                {{#each this.refunds as |refund|}}
                    <div class="rounded-md border border-gray-200 p-3 dark:border-gray-700">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-semibold text-gray-900 dark:text-white">{{format-currency refund.amount refund.currency}}</span>
                                    <Badge @status={{refund.refund_status}}>{{ledger-label (or refund.refund_status refund.status)}}</Badge>
                                    {{#if refund.wallet_status}}
                                        <Badge @status={{refund.wallet_status}}>{{ledger-label refund.wallet_status}}</Badge>
                                    {{/if}}
                                </div>
                                <div class="mt-1 text-xs text-gray-500">
                                    {{n-a refund.gateway.name}}
                                    ·
                                    {{n-a refund.created_at}}
                                </div>
                            </div>
                            <div class="flex flex-shrink-0 items-center gap-2">
                                <Button class="whitespace-nowrap" @icon="rotate" @text={{t "ledger.common.verify-status"}} @size="xs" @type="default" @onClick={{fn this.verifyRefundStatus refund}} />
                                {{#if refund.refund_url}}
                                    <Button class="whitespace-nowrap" @icon="paper-plane" @text={{t "ledger.common.send-email"}} @size="xs" @type="default" @onClick={{fn this.sendRefundUri refund}} />
                                {{/if}}
                            </div>
                        </div>

                        {{#if refund.refund_url}}
                            <div class="mt-3 flex min-w-0 items-center justify-between gap-3 rounded-md border border-gray-200 bg-white px-3 py-2 dark:border-gray-700 dark:bg-gray-800">
                                <ClickToCopy @value={{refund.refund_url}} class="min-w-0 flex-1">
                                    <a href={{refund.refund_url}} target="_blank" rel="noopener noreferrer" class="block truncate font-mono text-xs text-blue-600 hover:underline dark:text-blue-400">
                                        {{refund.refund_url}}
                                    </a>
                                </ClickToCopy>
                                <ClickToCopy @value={{refund.refund_url}} class="flex-shrink-0">
                                    <span class="text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400">{{t "ledger.common.copy"}}</span>
                                </ClickToCopy>
                            </div>
                            {{#if refund.taler_refund_uri}}
                                <div class="mt-2 flex min-w-0 items-center justify-between gap-3 rounded-md bg-gray-50 px-3 py-2 dark:bg-gray-900/40">
                                    <ClickToCopy @value={{refund.taler_refund_uri}} class="min-w-0 flex-1">
                                        <span class="block truncate font-mono text-[11px] text-gray-500 dark:text-gray-400">{{refund.taler_refund_uri}}</span>
                                    </ClickToCopy>
                                    <ClickToCopy @value={{refund.taler_refund_uri}} class="flex-shrink-0">
                                        <span class="text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400">{{t "ledger.common.copy-uri"}}</span>
                                    </ClickToCopy>
                                </div>
                            {{/if}}
                        {{else}}
                            <div class="mt-3 rounded-md bg-gray-50 p-2 text-xs text-gray-500 dark:bg-gray-800 dark:text-gray-400">
                                {{t "ledger.refund.this-refund-does-not-expose-a"}}
                            </div>
                        {{/if}}
                    </div>
                {{/each}}
            </div>
        {{else}}
            <div class="rounded-md border border-gray-200 p-4 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-300">
                {{t "ledger.refund.no-refund-uri-has-been-issued"}}
            </div>
        {{/if}}
    </div>
</Modal::Default>
