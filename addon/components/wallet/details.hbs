<div class="details-wrapper" ...attributes>
    {{! WALLET DETAILS }}
    <ContentPanel @title={{t "ledger.common.wallet-details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">

            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "ledger.common.wallet-information"}}
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.common.wallet-name"}}</div>
                <div class="field-value">{{n-a @resource.name}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "column.type"}}</div>
                <div class="field-value">{{n-a (ledger-label @resource.type "wallet-type")}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "column.currency"}}</div>
                <div class="field-value uppercase">{{n-a @resource.currency}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "column.status"}}</div>
                <div class="field-value">
                    {{#if @resource.status}}
                        <Badge @status={{@resource.status}} @text={{ledger-label @resource.status}} @disableHumanize={{true}} />
                    {{else}}
                        —
                    {{/if}}
                </div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "column.frozen"}}</div>
                <div class="field-value">{{if @resource.is_frozen (t "ledger.common.yes") (t "ledger.common.no")}}</div>
            </div>

            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "column.balance"}}
            </div>

            <div class="field-info-container col-span-2">
                <div class="field-name">{{t "ledger.common.current-balance"}}</div>
                <div class="field-value text-lg font-bold text-gray-900 dark:text-white">{{format-currency @resource.balance @resource.currency}}</div>
            </div>

            <div class="col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "ledger.common.owner-details"}}
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "column.owner"}}</div>
                <div class="field-value">{{n-a @resource.ownerName}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.common.owner-type"}}</div>
                <div class="field-value">{{n-a (ledger-label @resource.type "wallet-type")}}</div>
            </div>

            {{! Show email/phone only for user-type wallets }}
            {{#if (eq @resource.type "user")}}
                <div class="field-info-container">
                    <div class="field-name">{{t "ledger.common.email-phone"}}</div>
                    <div class="field-value">{{n-a @resource.ownerContact}}</div>
                </div>
            {{/if}}

        </div>
    </ContentPanel>

    {{! RECORD INFO }}
    <ContentPanel @title={{t "ledger.common.record-info"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.common.internal-id"}}</div>
                <div class="field-value font-mono">{{n-a @resource.public_id}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "column.created-at"}}</div>
                <div class="field-value">{{n-a @resource.createdAt}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "ledger.common.last-updated"}}</div>
                <div class="field-value">{{n-a @resource.updatedAt}}</div>
            </div>

        </div>
    </ContentPanel>
    <Spacer @height="200px" />
</div>