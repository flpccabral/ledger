<div class="form-wrapper" ...attributes>
    {{! ACCOUNT DETAILS }}
    <ContentPanel @title={{t "ledger.common.account-details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">

            {{! Identification }}
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "ledger.common.account-information"}}
            </div>

            <InputGroup @name={{t "ledger.common.account-name"}} @wrapperClass="col-span-2">
                <Input
                    @value={{@resource.name}}
                    @type="text"
                    class="w-full form-input"
                    placeholder={{t "ledger.accounting.e-g-cash-and-cash-equivalents"}}
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "ledger.common.account-code"}}>
                <Input @value={{@resource.code}} @type="text" class="w-full form-input" placeholder="e.g. 1000" disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "ledger.common.account-type"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{array "asset" "liability" "equity" "revenue" "expense"}}
                        @selected={{@resource.type}}
                        @onChange={{fn (mut @resource.type)}}
                        @placeholder={{t "ledger.common.select-account-type"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">{{ledger-label option "account-type"}}</div>
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "column.currency"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{array
                            "USD"
                            "EUR"
                            "GBP"
                            "AED"
                            "SAR"
                            "QAR"
                            "KWD"
                            "BHD"
                            "OMR"
                            "JOD"
                            "EGP"
                            "NGN"
                            "KES"
                            "GHS"
                            "ZAR"
                            "INR"
                            "PKR"
                            "BDT"
                            "MYR"
                            "SGD"
                            "IDR"
                            "PHP"
                            "THB"
                            "CNY"
                            "JPY"
                            "KRW"
                            "AUD"
                            "CAD"
                            "NZD"
                            "CHF"
                            "SEK"
                            "NOK"
                            "DKK"
                            "BRL"
                            "MXN"
                        }}
                        @selected={{@resource.currency}}
                        @onChange={{fn (mut @resource.currency)}}
                        @placeholder={{t "ledger.common.select-currency"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">{{option}}</div>
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "column.status"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{array "active" "inactive" "archived"}}
                        @selected={{@resource.status}}
                        @onChange={{fn (mut @resource.status)}}
                        @placeholder={{t "ledger.common.select-status"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">{{ledger-label option "status"}}</div>
                    </PowerSelect>
                </div>
            </InputGroup>

            {{! Description }}
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "column.description"}}
            </div>

            <InputGroup @name={{t "column.description"}} @wrapperClass="col-span-2">
                <Textarea
                    @value={{@resource.description}}
                    class="w-full form-input"
                    rows="3"
                    placeholder={{t "ledger.accounting.optional-description-of-this-account"}}
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>

        </div>
    </ContentPanel>

    <Spacer @height="100px" />
</div>