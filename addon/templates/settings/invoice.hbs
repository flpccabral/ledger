<Layout::Section::Header @title={{t "ledger.common.invoice-settings"}}>
    <Button
        @type="primary"
        @size="sm"
        @icon="save"
        @text={{t "ledger.common.save-changes"}}
        @onClick={{perform this.saveSettings}}
        @disabled={{this.saveSettings.isRunning}}
        @isLoading={{or this.saveSettings.isRunning this.getSettings.isRunning}}
    />
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full">
    <div class="container mx-auto h-screen">
        <div class="max-w-3xl my-10 mx-auto space-y-6">

            {{! ── Numbering ──────────────────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger.common.invoice-numbering"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "ledger.common.invoice-number-prefix"}} @helpText={{t "ledger.invoice-settings.this-prefix-is-prepended-to-every"}}>
                    <Input @value={{this.invoice_prefix}} @type="text" class="w-full form-input" placeholder="INV" />
                </InputGroup>
            </ContentPanel>

            {{! ── Currency & Payment Terms ────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger.invoice-settings.currency-and-payment-terms"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "ledger.common.default-currency"}} @helpText={{t "ledger.invoice-settings.the-currency-applied-to-new-invoices"}}>
                    <CurrencySelect
                        @currency={{this.effectiveCurrency}}
                        @currencyData={{this.selectedCurrency}}
                        @onCurrencyChange={{this.onSelectCurrency}}
                        @triggerClass="form-select form-input"
                        @placeholder={{t "ledger.invoice-settings.default-currency-placeholder" currency=this.companyCurrency}}
                        @allowClear={{true}}
                    />
                    {{#unless this.default_currency}}
                        <p class="text-xs text-gray-400 mt-1">{{t "ledger.invoice-settings.using-organisation-default-currency" currency=this.companyCurrency}}</p>
                    {{/unless}}
                </InputGroup>

                <InputGroup @name={{t "ledger.common.default-payment-terms"}} @helpText={{t "ledger.invoice-settings.number-of-days-after-the-invoice"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.paymentTermsOptions}}
                            @selected={{find-by "value" this.payment_terms_days this.paymentTermsOptions}}
                            @onChange={{this.onSelectPaymentTerms}}
                            @placeholder={{t "ledger.common.select-payment-terms"}}
                            @triggerClass="form-select form-input"
                            as |opt|
                        >
                            <div class="text-sm">{{opt.label}}</div>
                        </PowerSelect>
                    </div>
                </InputGroup>
            </ContentPanel>

            {{! ── Default Text ─────────────────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger.common.default-invoice-text"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "ledger.common.default-notes"}} @helpText={{t "ledger.invoice-settings.these-notes-appear-at-the-bottom"}}>
                    <Textarea @value={{this.default_notes}} class="w-full form-input" rows="3" placeholder={{t "ledger.invoice-settings.e-g-thank-you-for-your"}} />
                </InputGroup>

                <InputGroup @name={{t "ledger.invoice-settings.default-terms-and-conditions"}} @helpText={{t "ledger.invoice-settings.standard-terms-pre-filled-on-every"}}>
                    <Textarea @value={{this.default_terms}} class="w-full form-input" rows="3" placeholder={{t "ledger.invoice-settings.e-g-payment-is-due-within"}} />
                </InputGroup>
            </ContentPanel>

            {{! ── Default Template ─────────────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger.common.default-invoice-template"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "ledger.common.default-template"}} @helpText={{t "ledger.invoice-settings.the-invoice-template-applied-to-all"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.availableTemplates}}
                            @selected={{this.selectedTemplate}}
                            @onChange={{this.onSelectDefaultTemplate}}
                            @placeholder={{t "ledger.invoice-settings.select-an-invoice-template"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |template|
                        >
                            <div class="text-sm">{{template.name}}</div>
                        </PowerSelect>
                    </div>
                    {{#if this.selectedTemplate}}
                        <div class="mt-1 text-[11px] text-gray-500">
                            {{t "ledger.invoice-settings.selected"}}
                            <span class="font-medium">{{this.selectedTemplate.name}}</span>
                        </div>
                    {{/if}}
                    {{#unless this.availableTemplates.length}}
                        <div class="mt-1 text-[11px] text-amber-600">
                            {{t "ledger.invoice-settings.no-invoice-templates-found"}}
                            <LinkTo @route="billing.invoice-templates.index.new" class="underline">{{t "ledger.common.create-a-template"}}</LinkTo>
                            {{t "ledger.invoice-settings.to-enable-custom-invoice-branding"}}
                        </div>
                    {{/unless}}
                </InputGroup>
            </ContentPanel>

            {{! ── Automation ───────────────────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger.common.automation"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "ledger.common.auto-send-on-creation"}}>
                    <Toggle
                        @isToggled={{this.auto_send_on_creation}}
                        @label={{t "ledger.invoice-settings.automatically-email-the-invoice-to-the"}}
                        @onToggle={{fn (mut this.auto_send_on_creation)}}
                    />
                </InputGroup>
            </ContentPanel>
        </div>
        <Spacer @height="600px" />
    </div>
</Layout::Section::Body>