<Layout::Section::Header @title={{t "menu.accounting-settings"}}>
    <Button
        @type="primary"
        @size="sm"
        @icon="save"
        @text={{t "ledger.common.save-changes"}}
        @onClick={{perform this.saveSettings}}
        @disabled={{this.saveSettings.isRunning}}
        @isLoading={{or this.saveSettings.isRunning this.getSettings.isRunning}}
    />
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full">
    <div class="container mx-auto h-screen">
        <div class="max-w-3xl my-10 mx-auto space-y-6">

            {{! ── Base Currency & Fiscal Year ────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger.accounting-settings.currency-and-fiscal-year"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "ledger.common.base-currency"}} @helpText={{t "ledger.accounting-settings.the-reporting-currency-for-all-financial"}}>
                    <CurrencySelect
                        @currency={{this.effectiveCurrency}}
                        @currencyData={{this.selectedCurrency}}
                        @onCurrencyChange={{this.onSelectCurrency}}
                        @triggerClass="form-select form-input"
                        @placeholder={{t "ledger.invoice-settings.default-currency-placeholder" currency=this.companyCurrency}}
                        @allowClear={{true}}
                    />
                    {{#unless this.base_currency}}
                        <p class="text-xs text-gray-400 mt-1">{{t "ledger.invoice-settings.using-organisation-default-currency" currency=this.companyCurrency}}</p>
                    {{/unless}}
                </InputGroup>

                <InputGroup @name={{t "ledger.accounting-settings.fiscal-year-start-month"}} @helpText={{t "ledger.accounting-settings.the-month-in-which-your-organisation"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.fiscalYearMonthOptions}}
                            @selected={{find-by "value" this.fiscal_year_start_month this.fiscalYearMonthOptions}}
                            @onChange={{this.onSelectFiscalYearMonth}}
                            @placeholder={{t "ledger.common.select-start-month"}}
                            @triggerClass="form-select form-input"
                            as |opt|
                        >
                            <div class="text-sm">{{opt.label}}</div>
                        </PowerSelect>
                    </div>
                </InputGroup>
            </ContentPanel>

            {{! ── Default Accounts ────────────────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger.common.default-accounts"}} @open={{true}} @wrapperClass="bordered-classic">
                <div class="text-xs text-gray-500 mb-3">
                    {{t "ledger.accounting-settings.these-accounts-are-used-automatically-when"}}
                </div>

                <InputGroup @name={{t "ledger.common.default-revenue-account"}} @helpText={{t "ledger.accounting-settings.applied-to-income-line-items-on"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.revenueAccounts}}
                            @selected={{this.selectedRevenueAccount}}
                            @onChange={{this.onSelectRevenueAccount}}
                            @placeholder={{t "ledger.common.select-revenue-account"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |account|
                        >
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-medium">{{account.name}}</span>
                                {{#if account.code}}
                                    <span class="text-gray-400 text-xs ml-2 font-mono">{{account.code}}</span>
                                {{/if}}
                            </div>
                        </PowerSelect>
                    </div>
                </InputGroup>

                <InputGroup @name={{t "ledger.common.default-expense-account"}} @helpText={{t "ledger.accounting-settings.applied-to-cost-and-expense-line"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.expenseAccounts}}
                            @selected={{this.selectedExpenseAccount}}
                            @onChange={{this.onSelectExpenseAccount}}
                            @placeholder={{t "ledger.common.select-expense-account"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |account|
                        >
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-medium">{{account.name}}</span>
                                {{#if account.code}}
                                    <span class="text-gray-400 text-xs ml-2 font-mono">{{account.code}}</span>
                                {{/if}}
                            </div>
                        </PowerSelect>
                    </div>
                </InputGroup>

                <InputGroup @name={{t "ledger.accounting-settings.default-accounts-receivable-ar-account"}} @helpText={{t "ledger.accounting-settings.the-asset-account-that-tracks-money"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.arAccounts}}
                            @selected={{this.selectedArAccount}}
                            @onChange={{this.onSelectArAccount}}
                            @placeholder={{t "ledger.common.select-ar-account"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |account|
                        >
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-medium">{{account.name}}</span>
                                {{#if account.code}}
                                    <span class="text-gray-400 text-xs ml-2 font-mono">{{account.code}}</span>
                                {{/if}}
                            </div>
                        </PowerSelect>
                    </div>
                </InputGroup>

                <InputGroup @name={{t "ledger.accounting-settings.default-accounts-payable-ap-account"}} @helpText={{t "ledger.accounting-settings.the-liability-account-that-tracks-money"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.apAccounts}}
                            @selected={{this.selectedApAccount}}
                            @onChange={{this.onSelectApAccount}}
                            @placeholder={{t "ledger.common.select-ap-account"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |account|
                        >
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-medium">{{account.name}}</span>
                                {{#if account.code}}
                                    <span class="text-gray-400 text-xs ml-2 font-mono">{{account.code}}</span>
                                {{/if}}
                            </div>
                        </PowerSelect>
                    </div>
                </InputGroup>
            </ContentPanel>

            {{! ── Journal Entry Behaviour ────────────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger.common.journal-entry-behaviour"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "ledger.common.auto-post-journal-entries"}}>
                    <Toggle
                        @isToggled={{this.auto_post_journal_entries}}
                        @label={{t "ledger.accounting-settings.automatically-post-journal-entries-to-the"}}
                        @onToggle={{fn (mut this.auto_post_journal_entries)}}
                    />
                </InputGroup>
            </ContentPanel>
        </div>
        <Spacer @height="600px" />
    </div>
</Layout::Section::Body>